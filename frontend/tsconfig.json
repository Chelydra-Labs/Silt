{
  "compilerOptions": {
    "moduleResolution": "bundler",
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "resolveJsonModule": true,
    "types": ["node"],
    "verbatimModuleSyntax": true,
    // Match Vite/Vitest `$silt-app` alias so svelte-check resolves test imports (#766).
    // baseUrl is required for paths today; ignoreDeprecations silences the TS 7.0 notice.
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "$silt-app": ["./bindings/silt/app.js"]
    },
    /**
     * Typecheck JS in `.svelte` and `.js` files by default.
     * Disable checkJs if you'd like to use dynamic types in JS.
     * Note that setting allowJs false does not prevent the use
     * of JS in `.svelte` files.
     */
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    // Build/emit is handled by Vite; svelte-check only typechecks. Emit-on
    // would trip TS6089 ("would overwrite input file") for the generated
    // Wails bindings/*.js that src imports under allowJs/checkJs.
    "noEmit": true
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.js",
    "src/**/*.svelte"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
