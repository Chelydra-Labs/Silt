frontend/package-lock.json merge=union

# Pin Go toolchain files to LF in both the repo and the working tree. Go
# tooling (gofmt, go mod, wails generate) expects LF; without this, Windows
# editors/tools that rewrite a file with CRLF leave a phantom "modified"
# status under core.autocrlf=true even though git diff is empty. All tracked
# *.go/*.mod/*.sum files are already stored as LF, so this is preventive —
# it enforces the existing state rather than renormalizing anything.
*.go  text eol=lf
*.mod text eol=lf
*.sum text eol=lf

# Pin build scripts + Taskfile/nfpm YAML to LF in both repo and working tree.
# These run on Linux/CI bash and wails3/go tooling that expects LF; without a
# pin, a contributor whose core.autocrlf differs could commit a CRLF blob that
# breaks CI bash (shebangs) the same way a stale build does. Mirrors the *.go
# rule above.
*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Pin committed git hooks to LF. Hooks run via /bin/sh (Git Bash on Windows);
# a CRLF blob would surface as "/bin/sh\r: bad interpreter" and silently break
# the pre-commit/pre-push gates for Windows contributors. Matches the *.sh rule.
.githooks/* text eol=lf
