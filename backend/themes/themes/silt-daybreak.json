{
  "schema_version": "2.0.0",
  "id": "silt-daybreak",
  "name": "Daybreak",
  "author": "Chelydra Labs",
  "description": "Dark night giving way to warm dawn light: a twilight-blue app skeleton frames a warm off-white editor surface. The readability-exception dual-surface theme.",
  "typography": {
    "font_family": "'Inter', sans-serif",
    "mono_font_family": "'JetBrains Mono', monospace",
    "headline_font": "'Hanken Grotesk', sans-serif",
    "scale": {
      "size": { "xs": "0.75rem", "sm": "0.875rem", "base": "1rem", "lg": "1.125rem", "xl": "1.25rem", "2xl": "1.5rem" },
      "line_height": { "tight": "1.2", "normal": "1.55", "relaxed": "1.75" },
      "weight": { "normal": "400", "medium": "500", "semibold": "600" }
    }
  },
  "modes": {
    "dark": {
      "surfaces": {
        "app": { "bg": "#0c0e14", "border": "#1a1f2e", "text": "#eaeef5" },
        "panel": { "bg": "#12151e", "border": "#242a3c", "text": "#eaeef5" },
        "modal": { "bg": "#12151e", "border": "#384255", "text": "#eaeef5" },
        "card": { "bg": "#161a25", "border": "#242a3c", "text": "#eaeef5" }
      },
      "hover": "#1c2130",
      "active": "#242a3c",
      "border_active": "#384255",
      "border_focus": "#506080",
      "text_muted": "#94a3b8",
      "text_disabled": "#475569",
      "accent": {
        "primary": {
          "start": "#f59e0b",
          "end": "#d97706",
          "glow": "rgba(245,158,11,0.12)"
        },
        "secondary": {
          "start": "#818cf8",
          "end": "#6366f1",
          "glow": "rgba(129,140,248,0.10)"
        }
      },
      "status": {
        "warn": "#fbbf24",
        "danger": "#f43f5e",
        "success": "#22c55e"
      },
      "error": {
        "fg": "#f43f5e",
        "bg": "#1a0d12",
        "border": "#4d2030"
      },
      "radius": { "sm": "4px", "md": "8px", "lg": "12px", "xl": "16px", "full": "9999px" },
      "spacing": { "sm": "6px", "md": "10px", "lg": "16px", "xl": "24px" },
      "shadow": {
        "sm": "0 1px 2px color-mix(in oklch, var(--color-surface-app) 50%, transparent)",
        "md": "0 4px 12px color-mix(in oklch, var(--color-surface-app) 45%, transparent)",
        "lg": "0 12px 32px color-mix(in oklch, var(--color-surface-app) 40%, transparent)"
      },
      "editor": {
        "caret": "#f59e0b",
        "selection": "rgba(245,158,11,0.25)",
        "selection_text": "#eaeef5",
        "link": "#818cf8",
        "link_hover": "#6366f1",
        "highlight": "rgba(251,191,36,0.30)"
      }
    },
    "light": {
      "surfaces": {
        "app": { "bg": "#faf8f5", "border": "#ece6de", "text": "#1c1917" },
        "sidebar": { "bg": "#1c2842", "border": "#2c3c5e", "text": "#eaeef5" },
        "panel": { "bg": "#ffffff", "border": "#ddd6ca", "text": "#1c1917" },
        "modal": { "bg": "#ffffff", "border": "#b8aa94", "text": "#1c1917" },
        "card": { "bg": "#f5f1ec", "border": "#ddd6ca", "text": "#1c1917" }
      },
      "hover": "#ece6de",
      "active": "#ddd6ca",
      "border_active": "#b8aa94",
      "border_focus": "#8a7860",
      "text_muted": "#57534e",
      "text_disabled": "#a8a29e",
      "accent": {
        "primary": {
          "start": "#cc7408",
          "end": "#92400e",
          "glow": "rgba(204,116,8,0.12)"
        },
        "secondary": {
          "start": "#6366f1",
          "end": "#4f46e5",
          "glow": "rgba(99,102,241,0.10)"
        }
      },
      "status": {
        "warn": "#b45309",
        "danger": "#be123c",
        "success": "#16a34a"
      },
      "error": {
        "fg": "#be123c",
        "bg": "#fbeeee",
        "border": "#e8c6c8"
      },
      "radius": { "sm": "4px", "md": "8px", "lg": "12px", "xl": "16px", "full": "9999px" },
      "spacing": { "sm": "6px", "md": "10px", "lg": "16px", "xl": "24px" },
      "shadow": {
        "sm": "0 1px 2px color-mix(in oklch, var(--color-surface-app) 30%, transparent)",
        "md": "0 4px 12px color-mix(in oklch, var(--color-surface-app) 25%, transparent)",
        "lg": "0 12px 32px color-mix(in oklch, var(--color-surface-app) 20%, transparent)"
      },
      "editor": {
        "caret": "#cc7408",
        "selection": "rgba(204,116,8,0.20)",
        "selection_text": "#1c1917",
        "link": "#6366f1",
        "link_hover": "#4f46e5",
        "highlight": "rgba(180,83,9,0.22)"
      }
    }
  }
}
