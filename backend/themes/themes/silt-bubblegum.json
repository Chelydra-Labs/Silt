{
  "schema_version": "2.0.0",
  "id": "silt-bubblegum",
  "name": "Bubblegum",
  "author": "Chelydra Labs",
  "description": "Playful and vibrant: warm coral-pink primary with teal secondary on a magenta-tinged dark canvas. Light mode features a deep raspberry app skeleton with a warm cream page.",
  "typography": {
    "font_family": "'Outfit', sans-serif",
    "mono_font_family": "'Fira Code', monospace",
    "headline_font": "'Sora', sans-serif",
    "scale": {
      "size": { "xs": "0.75rem", "sm": "0.875rem", "base": "1rem", "lg": "1.125rem", "xl": "1.3125rem", "2xl": "1.625rem" },
      "line_height": { "tight": "1.2", "normal": "1.55", "relaxed": "1.75" },
      "weight": { "normal": "400", "medium": "500", "semibold": "600" }
    }
  },
  "modes": {
    "dark": {
      "surfaces": {
        "app": { "bg": "#1a0e1e", "border": "#2e1a34", "text": "#f5ede8" },
        "panel": { "bg": "#221326", "border": "#3d2344", "text": "#f5ede8" },
        "modal": { "bg": "#221326", "border": "#5a3360", "text": "#f5ede8" },
        "card": { "bg": "#291830", "border": "#3d2344", "text": "#f5ede8" }
      },
      "hover": "#321e3a",
      "active": "#3b2444",
      "border_active": "#5a3360",
      "border_focus": "#7a4480",
      "text_muted": "#c4a8b8",
      "text_disabled": "#6a4a58",
      "accent": {
        "primary": {
          "start": "#ff6b8a",
          "end": "#e84371",
          "glow": "rgba(232,67,113,0.15)"
        },
        "secondary": {
          "start": "#4fd1c5",
          "end": "#38b2ac",
          "glow": "rgba(79,209,197,0.12)"
        }
      },
      "status": {
        "warn": "#ffc857",
        "danger": "#ff5a78",
        "success": "#4dd0c0"
      },
      "error": {
        "fg": "#ff5a78",
        "bg": "#1f0a14",
        "border": "#5a1a38"
      },
      "radius": { "sm": "6px", "md": "10px", "lg": "14px", "xl": "18px", "full": "9999px" },
      "spacing": { "sm": "6px", "md": "10px", "lg": "16px", "xl": "24px" },
      "shadow": {
        "sm": "0 1px 2px color-mix(in oklch, var(--color-surface-app) 50%, transparent)",
        "md": "0 4px 14px color-mix(in oklch, var(--color-surface-app) 45%, transparent)",
        "lg": "0 12px 32px color-mix(in oklch, var(--color-surface-app) 40%, transparent)"
      },
      "editor": {
        "caret": "#ff6b8a",
        "selection": "rgba(255,107,138,0.28)",
        "selection_text": "#f5ede8",
        "link": "#4fd1c5",
        "link_hover": "#38b2ac",
        "highlight": "rgba(255,200,87,0.30)"
      }
    },
    "light": {
      "surfaces": {
        "app": { "bg": "#f7ece2", "border": "#e8cfc0", "text": "#2d1f1a" },
        "sidebar": {
          "bg": "#2a1322",
          "border": "#3d1e32",
          "text": "#f5ede8",
          "text_muted": "#c8a8b8",
          "text_disabled": "#8a6a78"
        },
        "editor": { "bg": "#fdf5ec", "border": "#e2c4b2", "text": "#2d1f1a" },
        "panel": { "bg": "#faeee3", "border": "#e4c8b6", "text": "#2d1f1a" },
        "card": { "bg": "#fdf4ea", "border": "#eccfbd", "text": "#2d1f1a" },
        "modal": { "bg": "#fff9f1", "border": "#c89a86", "text": "#2d1f1a" },
        "popover": { "bg": "#fffcf7", "border": "#bc8e78", "text": "#2d1f1a" }
      },
      "hover": "#f0e0d4",
      "active": "#e4d0c0",
      "border_active": "#a8786a",
      "border_focus": "#6a4458",
      "text_muted": "#56403a",
      "text_disabled": "#ae8c7e",
      "accent": {
        "primary": {
          "start": "#e84371",
          "end": "#c2185b",
          "glow": "rgba(232,67,113,0.10)"
        },
        "secondary": {
          "start": "#2c7a7b",
          "end": "#234e52",
          "glow": "rgba(44,122,123,0.08)"
        }
      },
      "status": {
        "warn": "#c46a1a",
        "danger": "#c8324a",
        "success": "#1f7a78"
      },
      "error": {
        "fg": "#c8324a",
        "bg": "#fce2e8",
        "border": "#e08aa0"
      },
      "radius": { "sm": "6px", "md": "10px", "lg": "14px", "xl": "18px", "full": "9999px" },
      "spacing": { "sm": "6px", "md": "10px", "lg": "16px", "xl": "24px" },
      "shadow": {
        "sm": "0 1px 2px color-mix(in oklch, var(--color-surface-app) 30%, transparent)",
        "md": "0 4px 14px color-mix(in oklch, var(--color-surface-app) 25%, transparent)",
        "lg": "0 12px 32px color-mix(in oklch, var(--color-surface-app) 20%, transparent)"
      },
      "editor": {
        "caret": "#e84371",
        "selection": "rgba(232,67,113,0.20)",
        "selection_text": "#2d1f1a",
        "link": "#2c7a7b",
        "link_hover": "#234e52",
        "highlight": "rgba(196,106,26,0.22)"
      }
    }
  }
}
