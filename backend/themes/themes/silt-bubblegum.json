{
  "schema_version": "2.0.0",
  "id": "silt-bubblegum",
  "name": "Bubblegum",
  "author": "Chelydra Labs",
  "description": "Playful and vibrant: warm coral-pink primary with teal secondary on a magenta-tinged dark canvas. Light mode features a deep raspberry app skeleton with a warm cream page.",
  "typography": {
    "font_family": "'Outfit', sans-serif",
    "mono_font_family": "'Fira Code', monospace",
    "headline_font": "'Sora', sans-serif"
  },
  "modes": {
    "dark": {
      "surfaces": {
        "app": { "bg": "#1a0e1e", "border": "#2e1a34", "text": "#f5ede8" },
        "panel": { "bg": "#221326", "border": "#3d2344", "text": "#f5ede8" },
        "modal": { "bg": "#221326", "border": "#5a3360", "text": "#f5ede8" },
        "card": { "bg": "#291830", "border": "#3d2344", "text": "#f5ede8" }
      },
      "hover": "#321e3a",
      "active": "#3b2444",
      "border_active": "#5a3360",
      "border_focus": "#7a4480",
      "text_muted": "#c4a8b8",
      "text_disabled": "#6a4a58",
      "accent": {
        "primary": {
          "start": "#ff6b8a",
          "end": "#e84371",
          "glow": "rgba(232,67,113,0.15)"
        },
        "secondary": {
          "start": "#4fd1c5",
          "end": "#38b2ac",
          "glow": "rgba(79,209,197,0.12)"
        }
      },
      "status": {
        "warn": "#fbbf24",
        "danger": "#f43f5e",
        "success": "#22c55e"
      },
      "error": {
        "fg": "#f43f5e",
        "bg": "#221326",
        "border": "#5a3360"
      }
    },
    "light": {
      "surfaces": {
        "app": { "bg": "#fdf6f0", "border": "#f0e4d8", "text": "#2d1f1a" },
        "sidebar": { "bg": "#2a1322", "border": "#3d1e32", "text": "#f5ede8" },
        "panel": { "bg": "#ffffff", "border": "#e4d4c4", "text": "#2d1f1a" },
        "modal": { "bg": "#ffffff", "border": "#c4a494", "text": "#2d1f1a" },
        "card": { "bg": "#f7eee6", "border": "#e4d4c4", "text": "#2d1f1a" }
      },
      "hover": "#f0e4d8",
      "active": "#e4d4c4",
      "border_active": "#c4a494",
      "border_focus": "#8a6a5a",
      "text_muted": "#6b5048",
      "text_disabled": "#b8a098",
      "accent": {
        "primary": {
          "start": "#e84371",
          "end": "#c2185b",
          "glow": "rgba(232,67,113,0.10)"
        },
        "secondary": {
          "start": "#2c7a7b",
          "end": "#234e52",
          "glow": "rgba(44,122,123,0.08)"
        }
      },
      "status": {
        "warn": "#d97706",
        "danger": "#e11d48",
        "success": "#16a34a"
      },
      "error": {
        "fg": "#e11d48",
        "bg": "#ffffff",
        "border": "#c4a494"
      }
    }
  }
}
