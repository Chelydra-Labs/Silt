{
  "schema_version": "1.0.0",
  "id": "silt-bubblegum",
  "name": "Bubblegum",
  "author": "Chelydra Labs",
  "description": "Playful and vibrant: warm coral-pink primary with teal secondary on a magenta-tinged dark canvas. Light mode features a deep raspberry app skeleton with a warm cream page.",
  "typography": {
    "font_family": "'Outfit', sans-serif",
    "mono_font_family": "'Fira Code', monospace",
    "headline_font": "'Sora', sans-serif"
  },
  "modes": {
    "dark": {
      "bg": {
        "void": "#1a0e1e",
        "surface": "#221326",
        "panel": "#291830",
        "hover": "#321e3a",
        "active": "#3b2444"
      },
      "border": {
        "muted": "#2e1a34",
        "zinc": "#3d2344",
        "active": "#5a3360",
        "focus": "#7a4480"
      },
      "text": {
        "primary": "#f5ede8",
        "muted": "#c4a8b8",
        "disabled": "#6a4a58"
      },
      "accent": {
        "primary": {
          "start": "#ff6b8a",
          "end": "#e84371",
          "glow": "rgba(232,67,113,0.15)"
        },
        "secondary": {
          "start": "#4fd1c5",
          "end": "#38b2ac",
          "glow": "rgba(79,209,197,0.12)"
        }
      },
      "status": {
        "warn": "#fbbf24",
        "danger": "#f43f5e",
        "success": "#22c55e"
      }
    },
    "light": {
      "bg": {
        "void": "#fdf6f0",
        "surface": "#ffffff",
        "panel": "#f7eee6",
        "hover": "#f0e4d8",
        "active": "#e4d4c4"
      },
      "border": {
        "muted": "#f0e4d8",
        "zinc": "#e4d4c4",
        "active": "#c4a494",
        "focus": "#8a6a5a"
      },
      "text": {
        "primary": "#2d1f1a",
        "muted": "#6b5048",
        "disabled": "#b8a098"
      },
      "accent": {
        "primary": {
          "start": "#e84371",
          "end": "#c2185b",
          "glow": "rgba(232,67,113,0.10)"
        },
        "secondary": {
          "start": "#2c7a7b",
          "end": "#234e52",
          "glow": "rgba(44,122,123,0.08)"
        }
      },
      "status": {
        "warn": "#d97706",
        "danger": "#e11d48",
        "success": "#16a34a"
      },
      "chrome": {
        "bg": {
          "void": "#2a1322",
          "surface": "#381a2e",
          "panel": "#3d1e32",
          "hover": "#482440",
          "active": "#552a4a"
        },
        "border": {
          "muted": "#3d1e32",
          "zinc": "#4d2840",
          "active": "#6a3a58",
          "focus": "#8a4d70"
        },
        "text": {
          "primary": "#f5ede8",
          "muted": "#c4a8b8",
          "disabled": "#7a5a68"
        }
      }
    }
  }
}
