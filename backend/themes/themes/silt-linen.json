            "size": "tile",
            "opacity": 0.08,
            "blend": "overlay"
          }
        },
        "panel": { "bg": "#2b2825", "border": "#443f3a", "text": "#e8e3d8" },
        "modal": { "bg": "#302c29", "border": "#57504a", "text": "#e8e3d8" },
        "card": { "bg": "#312e2a", "border": "#443f3a", "text": "#e8e3d8" },
        "popover": { "bg": "#383431", "border": "#665d54", "text": "#e8e3d8" }
