{
  "schema_version": "2.0.0",
  "id": "silt-linen",
  "name": "Linen",
  "author": "Chelydra Labs",
  "description": "Easy-on-the-eyes linen paper: warm grey-taupe canvas with a woven grain texture, soft slate-blue and muted lilac accents.",
  "typography": {
