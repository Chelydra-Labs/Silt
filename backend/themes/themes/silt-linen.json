          "start": "#7fb3c4",
          "end": "#5d97ab",
          "glow": "rgba(127, 179, 196, 0.12)"
        },
        "secondary": {
          "start": "#a8a3d4",
          "end": "#847cb0",
          "glow": "rgba(168, 163, 212, 0.10)"
