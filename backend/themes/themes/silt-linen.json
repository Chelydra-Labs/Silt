          "start": "#4a8a9c",
          "end": "#3a7383",
          "glow": "rgba(74, 138, 156, 0.10)"
        },
        "secondary": {
          "start": "#686da3",
          "end": "#565b8e",
          "glow": "rgba(104, 109, 163, 0.08)"
        }
      },
