{
  "schema_version": "2.0.0",
  "id": "cyber_forest",
  "name": "Cyber Forest",
  "author": "Chelydra Labs",
  "description": "The default Silt dark theme: ink-rich slate canvas with surgical teal primary and indigo secondary accents.",
  "typography": {
    "font_family": "'Plus Jakarta Sans', sans-serif",
    "mono_font_family": "'JetBrains Mono', monospace",
    "headline_font": "'Hanken Grotesk', sans-serif",
    "scale": {
      "size": { "xs": "0.75rem", "sm": "0.875rem", "base": "1rem", "lg": "1.125rem", "xl": "1.25rem", "2xl": "1.5rem" },
      "line_height": { "tight": "1.2", "normal": "1.5", "relaxed": "1.7" },
      "weight": { "normal": "400", "medium": "500", "semibold": "600" }
    }
  },
  "modes": {
    "dark": {
      "surfaces": {
        "app": { "bg": "#0c0c0e", "border": "#1e1e23", "text": "#dee3e6" },
        "editor": { "bg": "#0f0f13", "border": "#23232a", "text": "#dee3e6" },
        "panel": { "bg": "#121215", "border": "#27272a", "text": "#dee3e6" },
        "modal": { "bg": "#151519", "border": "#3f3f46", "text": "#dee3e6" },
        "card": { "bg": "#161619", "border": "#27272a", "text": "#dee3e6" },
        "popover": { "bg": "#191920", "border": "#4a4a52", "text": "#dee3e6" }
      },
      "hover": "#1c1c21",
      "active": "#222226",
      "border_active": "#3f3f46",
      "border_focus": "#52525b",
      "text_muted": "#8b8b94",
      "text_disabled": "#4b5563",
      "accent": {
        "primary": {
          "start": "#2dd4bf",
          "end": "#0d9488",
          "glow": "rgba(45, 212, 191, 0.15)"
        },
        "secondary": {
          "start": "#6366f1",
          "end": "#a855f7",
          "glow": "rgba(99, 102, 241, 0.12)"
        }
      },
      "status": {
        "warn": "#e0b04a",
        "danger": "#dd5a72",
        "success": "#37b594"
      },
      "error": {
        "fg": "#e8728a",
        "bg": "#171015",
        "border": "#4a2a38"
      },
      "radius": { "sm": "4px", "md": "8px", "lg": "12px", "xl": "16px", "full": "9999px" },
      "spacing": { "sm": "4px", "md": "8px", "lg": "16px", "xl": "24px" },
      "shadow": {
        "sm": "0 1px 2px color-mix(in oklch, var(--color-surface-app) 50%, transparent)",
        "md": "0 4px 12px color-mix(in oklch, var(--color-surface-app) 45%, transparent)",
        "lg": "0 12px 32px color-mix(in oklch, var(--color-surface-app) 40%, transparent)"
      },
      "editor": {
        "caret": "#2dd4bf",
        "selection": "rgba(45,212,191,0.25)",
        "selection_text": "#dee3e6",
        "link": "#6366f1",
        "link_hover": "#a855f7",
        "highlight": "rgba(224,176,74,0.30)"
      }
    },
    "light": {
      "surfaces": {
        "app": { "bg": "#f8fafc", "border": "#e2e8f0", "text": "#0f172a" },
        "editor": { "bg": "#fcfdfe", "border": "#d0d7e0", "text": "#0f172a" },
        "panel": { "bg": "#ffffff", "border": "#cbd5e1", "text": "#0f172a" },
        "card": { "bg": "#f1f5f9", "border": "#cbd5e1", "text": "#0f172a" },
        "modal": { "bg": "#ffffff", "border": "#94a3b8", "text": "#0f172a" },
        "popover": { "bg": "#ffffff", "border": "#64748b", "text": "#0f172a" }
      },
      "hover": "#e2e8f0",
      "active": "#cbd5e1",
      "border_active": "#94a3b8",
      "border_focus": "#64748b",
      "text_muted": "#4d5667",
      "text_disabled": "#94a3b8",
      "accent": {
        "primary": {
          "start": "#0d9488",
          "end": "#115e59",
          "glow": "rgba(13, 148, 136, 0.10)"
        },
        "secondary": {
          "start": "#4f46e5",
          "end": "#7c3aed",
          "glow": "rgba(79, 70, 229, 0.08)"
        }
      },
      "status": {
        "warn": "#d97706",
        "danger": "#e11d48",
        "success": "#16a34a"
      },
      "error": {
        "fg": "#a83828",
        "bg": "#ffffff",
        "border": "#94a3b8"
      },
      "radius": { "sm": "4px", "md": "8px", "lg": "12px", "xl": "16px", "full": "9999px" },
      "spacing": { "sm": "4px", "md": "8px", "lg": "16px", "xl": "24px" },
      "shadow": {
        "sm": "0 1px 2px color-mix(in oklch, var(--color-surface-app) 30%, transparent)",
        "md": "0 4px 12px color-mix(in oklch, var(--color-surface-app) 25%, transparent)",
        "lg": "0 12px 32px color-mix(in oklch, var(--color-surface-app) 20%, transparent)"
      },
      "editor": {
        "caret": "#0d9488",
        "selection": "rgba(13,148,136,0.20)",
        "selection_text": "#0f172a",
        "link": "#4f46e5",
        "link_hover": "#7c3aed",
        "highlight": "rgba(217,119,6,0.25)"
      }
    }
  }
}
