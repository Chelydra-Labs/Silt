{
  "schema_version": "2.0.0",
  "id": "silt-frost",
  "name": "Frost",
  "author": "Chelydra Labs",
  "description": "Clean and airy: a crisp blue-tinted palette that feels like a winter morning. Cool steel-blue dark mode, brilliant ice-white light mode with sky-blue accents.",
  "typography": {
    "font_family": "'DM Sans', sans-serif",
    "mono_font_family": "'Geist Mono', monospace",
    "headline_font": "'Lexend', sans-serif"
  },
  "modes": {
    "dark": {
      "surfaces": {
        "app": { "bg": "#0a0e14", "border": "#1a2433", "text": "#e2eaf2" },
        "panel": { "bg": "#101620", "border": "#263348", "text": "#e2eaf2" },
        "modal": { "bg": "#101620", "border": "#3a4d68", "text": "#e2eaf2" },
        "card": { "bg": "#161e2a", "border": "#263348", "text": "#e2eaf2" }
      },
      "hover": "#1d2838",
      "active": "#263348",
      "border_active": "#3a4d68",
      "border_focus": "#5a7390",
      "text_muted": "#94a4b8",
      "text_disabled": "#4a5a6e",
      "accent": {
        "primary": {
          "start": "#38bdf8",
          "end": "#0ea5e9",
          "glow": "rgba(56,189,248,0.12)"
        },
        "secondary": {
          "start": "#818cf8",
          "end": "#6366f1",
          "glow": "rgba(129,140,248,0.10)"
        }
      },
      "status": {
        "warn": "#fbbf24",
        "danger": "#f43f5e",
        "success": "#22c55e"
      },
      "error": {
        "fg": "#f43f5e",
        "bg": "#101620",
        "border": "#3a4d68"
      }
    },
    "light": {
      "surfaces": {
        "app": { "bg": "#f0f4fa", "border": "#dde6f0", "text": "#061020" },
        "panel": { "bg": "#ffffff", "border": "#c8d6e6", "text": "#061020" },
        "modal": { "bg": "#ffffff", "border": "#94a8c0", "text": "#061020" },
        "card": { "bg": "#e8eef6", "border": "#c8d6e6", "text": "#061020" }
      },
      "hover": "#dde6f0",
      "active": "#c8d6e6",
      "border_active": "#94a8c0",
      "border_focus": "#5a7090",
      "text_muted": "#3a4a60",
      "text_disabled": "#8a9aae",
      "accent": {
        "primary": {
          "start": "#0284c7",
          "end": "#0369a1",
          "glow": "rgba(2,132,199,0.10)"
        },
        "secondary": {
          "start": "#4f46e5",
          "end": "#3730a3",
          "glow": "rgba(79,70,229,0.08)"
        }
      },
      "status": {
        "warn": "#d97706",
        "danger": "#e11d48",
        "success": "#16a34a"
      },
      "error": {
        "fg": "#e11d48",
        "bg": "#ffffff",
        "border": "#94a8c0"
      }
    }
  }
}
