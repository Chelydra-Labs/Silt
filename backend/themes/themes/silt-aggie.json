{
  "schema_version": "2.0.0",
  "id": "silt-aggie",
  "name": "Aggie",
  "author": "Chelydra Labs",
  "description": "Heritage split: dark mode evokes Colorado A&M's original alfalfa green and pumpkin orange; light mode shifts to CSU's modern green and gold. An agricultural alpine easter egg.",
  "typography": {
    "font_family": "'Work Sans', sans-serif",
    "mono_font_family": "'IBM Plex Mono', monospace",
    "headline_font": "'Manrope', sans-serif"
  },
  "modes": {
    "dark": {
      "surfaces": {
        "app": { "bg": "#0a1810", "border": "#1a2820", "text": "#e8efe0" },
        "panel": { "bg": "#0f2018", "border": "#223830", "text": "#e8efe0" },
        "modal": { "bg": "#0f2018", "border": "#365040", "text": "#e8efe0" },
        "card": { "bg": "#142820", "border": "#223830", "text": "#e8efe0" }
      },
      "hover": "#1a3228",
      "active": "#223e30",
      "border_active": "#365040",
      "border_focus": "#507060",
      "text_muted": "#9ab090",
      "text_disabled": "#3a5a3e",
      "accent": {
        "primary": {
          "start": "#e07a30",
          "end": "#b45a18",
          "glow": "rgba(217,120,45,0.15)"
        },
        "secondary": {
          "start": "#6aaa4a",
          "end": "#3a7a2a",
          "glow": "rgba(106,170,74,0.12)"
        }
      },
      "status": {
        "warn": "#f0a823",
        "danger": "#d83a3a",
        "success": "#22c55e"
      },
      "error": {
        "fg": "#d83a3a",
        "bg": "#0f2018",
        "border": "#365040"
      }
    },
    "light": {
      "surfaces": {
        "app": { "bg": "#f0f5ee", "border": "#d8e4d6", "text": "#1e4d2b" },
        "panel": { "bg": "#ffffff", "border": "#c4d4c2", "text": "#1e4d2b" },
        "modal": { "bg": "#ffffff", "border": "#8aaa88", "text": "#1e4d2b" },
        "card": { "bg": "#e8efe6", "border": "#c4d4c2", "text": "#1e4d2b" }
      },
      "hover": "#d8e4d6",
      "active": "#c4d4c2",
      "border_active": "#8aaa88",
      "border_focus": "#5a7a5a",
      "text_muted": "#3a5a3a",
      "text_disabled": "#8aaa88",
      "accent": {
        "primary": {
          "start": "#7a6408",
          "end": "#5f4a06",
          "glow": "rgba(200,195,114,0.10)"
        },
        "secondary": {
          "start": "#006144",
          "end": "#004d36",
          "glow": "rgba(0,97,68,0.08)"
        }
      },
      "status": {
        "warn": "#b8791a",
        "danger": "#bd3434",
        "success": "#16a34a"
      },
      "error": {
        "fg": "#bd3434",
        "bg": "#ffffff",
        "border": "#8aaa88"
      }
    }
  }
}
