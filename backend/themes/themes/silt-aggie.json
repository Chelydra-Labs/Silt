{
  "schema_version": "2.0.0",
  "id": "silt-aggie",
  "name": "Aggie",
  "author": "Chelydra Labs",
  "description": "Heritage split: dark mode evokes Colorado A&M's original alfalfa green and pumpkin orange; light mode shifts to CSU's modern green and gold. An agricultural alpine easter egg.",
  "typography": {
    "font_family": "'Work Sans', sans-serif",
    "mono_font_family": "'IBM Plex Mono', monospace",
    "headline_font": "'Manrope', sans-serif",
    "scale": {
      "size": { "xs": "0.75rem", "sm": "0.875rem", "base": "1rem", "lg": "1.125rem", "xl": "1.25rem", "2xl": "1.5rem" },
      "line_height": { "tight": "1.2", "normal": "1.55", "relaxed": "1.75" },
      "weight": { "normal": "400", "medium": "500", "semibold": "600" }
    }
  },
  "modes": {
    "dark": {
      "surfaces": {
        "app": { "bg": "#0a1810", "border": "#1a2820", "text": "#e8efe0" },
        "editor": { "bg": "#0d1c14", "border": "#1e3028", "text": "#e8efe0" },
        "panel": { "bg": "#0f2018", "border": "#223830", "text": "#e8efe0" },
        "modal": { "bg": "#13281e", "border": "#365040", "text": "#e8efe0" },
        "card": { "bg": "#142820", "border": "#223830", "text": "#e8efe0" },
        "popover": { "bg": "#1a3328", "border": "#3e6048", "text": "#e8efe0" }
      },
      "hover": "#1a3328",
      "active": "#223e30",
      "border_active": "#365040",
      "border_focus": "#507060",
      "text_muted": "#9ab090",
      "text_disabled": "#3a5a3e",
      "accent": {
        "primary": {
          "start": "#e07a30",
          "end": "#b45a18",
          "glow": "rgba(224,122,48,0.15)"
        },
        "secondary": {
          "start": "#6aaa4a",
          "end": "#3a7a2a",
          "glow": "rgba(106,170,74,0.12)"
        }
      },
      "status": {
        "warn": "#e8a13c",
        "danger": "#c84438",
        "success": "#5fa848"
      },
      "error": {
        "fg": "#ee6050",
        "bg": "#1a0e0a",
        "border": "#4d2a20"
      },
      "radius": { "sm": "4px", "md": "6px", "lg": "10px", "xl": "14px", "full": "9999px" },
      "spacing": { "sm": "6px", "md": "10px", "lg": "16px", "xl": "24px" },
      "shadow": {
        "sm": "0 1px 2px color-mix(in oklch, var(--color-surface-app) 50%, transparent)",
        "md": "0 4px 12px color-mix(in oklch, var(--color-surface-app) 45%, transparent)",
        "lg": "0 12px 32px color-mix(in oklch, var(--color-surface-app) 40%, transparent)"
      },
      "editor": {
        "caret": "#e07a30",
        "selection": "rgba(224,122,48,0.25)",
        "selection_text": "#e8efe0",
        "link": "#6aaa4a",
        "link_hover": "#3a7a2a",
        "highlight": "rgba(232,161,60,0.28)"
      }
    },
    "light": {
      "surfaces": {
        "app": { "bg": "#dce8d2", "border": "#7c9862", "text": "#1e4d2b" },
        "editor": { "bg": "#e1eee0", "border": "#809c66", "text": "#1e4d2b" },
        "panel": { "bg": "#e6f2e3", "border": "#6e8a54", "text": "#1e4d2b" },
        "card": { "bg": "#ebf5e9", "border": "#64804a", "text": "#1e4d2b" },
        "modal": { "bg": "#f0f8ed", "border": "#547040", "text": "#1e4d2b" },
        "popover": { "bg": "#f6fcf3", "border": "#486438", "text": "#1e4d2b" }
      },
      "hover": "#cce0bc",
      "active": "#b4ce9c",
      "border_active": "#748e60",
      "border_focus": "#3e5832",
      "text_muted": "#2e4a2c",
      "text_disabled": "#789a74",
      "accent": {
        "primary": {
          "start": "#a07c00",
          "end": "#6e5400",
          "glow": "rgba(160,124,0,0.10)"
        },
        "secondary": {
          "start": "#006144",
          "end": "#004d36",
          "glow": "rgba(0,97,68,0.08)"
        }
      },
      "status": {
        "warn": "#9c6a22",
        "danger": "#a82c2c",
        "success": "#2a7a22"
      },
      "error": {
        "fg": "#862626",
        "bg": "#fbe6e6",
        "border": "#d08a8a"
      },
      "radius": { "sm": "4px", "md": "6px", "lg": "10px", "xl": "14px", "full": "9999px" },
      "spacing": { "sm": "6px", "md": "10px", "lg": "16px", "xl": "24px" },
      "shadow": {
        "sm": "0 1px 2px color-mix(in oklch, var(--color-surface-app) 30%, transparent)",
        "md": "0 4px 12px color-mix(in oklch, var(--color-surface-app) 25%, transparent)",
        "lg": "0 12px 32px color-mix(in oklch, var(--color-surface-app) 20%, transparent)"
      },
      "editor": {
        "caret": "#a07c00",
        "selection": "rgba(160,124,0,0.22)",
        "selection_text": "#1e4d2b",
        "link": "#006144",
        "link_hover": "#004d36",
        "highlight": "rgba(156,106,34,0.22)"
      }
    }
  }
}
