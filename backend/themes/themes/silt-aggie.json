{
  "schema_version": "1.0.0",
  "id": "silt-aggie",
  "name": "Aggie",
  "author": "Chelydra Labs",
  "description": "Heritage split: dark mode evokes Colorado A&M's original alfalfa green and pumpkin orange; light mode shifts to CSU's modern green and gold. An agricultural alpine easter egg.",
  "typography": {
    "font_family": "'Work Sans', sans-serif",
    "mono_font_family": "'IBM Plex Mono', monospace",
    "headline_font": "'Manrope', sans-serif"
  },
  "modes": {
    "dark": {
      "bg": {
        "void": "#0a1810",
        "surface": "#0f2018",
        "panel": "#142820",
        "hover": "#1a3228",
        "active": "#223e30"
      },
      "border": {
        "muted": "#1a2820",
        "zinc": "#223830",
        "active": "#365040",
        "focus": "#507060"
      },
      "text": {
        "primary": "#e8efe0",
        "muted": "#9ab090",
        "disabled": "#3a5a3e"
      },
      "accent": {
        "primary": {
          "start": "#e07a30",
          "end": "#b45a18",
          "glow": "rgba(217,120,45,0.15)"
        },
        "secondary": {
          "start": "#6aaa4a",
          "end": "#3a7a2a",
          "glow": "rgba(106,170,74,0.12)"
        }
      },
      "status": {
        "warn": "#f0a823",
        "danger": "#d83a3a",
        "success": "#22c55e"
      }
    },
    "light": {
      "bg": {
        "void": "#f0f5ee",
        "surface": "#ffffff",
        "panel": "#e8efe6",
        "hover": "#d8e4d6",
        "active": "#c4d4c2"
      },
      "border": {
        "muted": "#d8e4d6",
        "zinc": "#c4d4c2",
        "active": "#8aaa88",
        "focus": "#5a7a5a"
      },
      "text": {
        "primary": "#1e4d2b",
        "muted": "#3a5a3a",
        "disabled": "#8aaa88"
      },
      "accent": {
        "primary": {
          "start": "#7a6408",
          "end": "#5f4a06",
          "glow": "rgba(200,195,114,0.10)"
        },
        "secondary": {
          "start": "#006144",
          "end": "#004d36",
          "glow": "rgba(0,97,68,0.08)"
        }
      },
      "status": {
        "warn": "#b8791a",
        "danger": "#bd3434",
        "success": "#16a34a"
      }
    }
  }
}
