{
  "schema_version": "2.0.0",
  "id": "silt-stark",
  "name": "Stark",
  "author": "Chelydra Labs",
  "description": "High-contrast / accessibility theme (WCAG AAA): pure black/white extremes with gold and cyan accents.",
  "typography": {
    "font_family": "'Atkinson Hyperlegible', sans-serif",
    "mono_font_family": "'Geist Mono', monospace",
    "headline_font": "'Atkinson Hyperlegible', sans-serif",
    "scale": {
      "size": { "xs": "0.75rem", "sm": "0.875rem", "base": "1rem", "lg": "1.125rem", "xl": "1.375rem", "2xl": "1.75rem" },
      "line_height": { "tight": "1.15", "normal": "1.5", "relaxed": "1.7" },
      "weight": { "normal": "400", "medium": "600", "semibold": "700" }
    }
  },
  "modes": {
    "dark": {
      "surfaces": {
        "app": { "bg": "#000000", "border": "#3d3d3d", "text": "#ffffff" },
        "panel": { "bg": "#0a0a0a", "border": "#5e5e5e", "text": "#ffffff" },
        "modal": { "bg": "#0a0a0a", "border": "#ffffff", "text": "#ffffff" },
        "card": { "bg": "#141414", "border": "#5e5e5e", "text": "#ffffff" }
      },
      "hover": "#1f1f1f",
      "active": "#2a2a2a",
      "border_active": "#ffffff",
      "border_focus": "#ffd400",
      "text_muted": "#d4d4d4",
      "text_disabled": "#a8a8a8",
      "accent": {
        "primary": {
          "start": "#ffd400",
          "end": "#ffb800",
          "glow": "rgba(255,212,0,0.20)"
        },
        "secondary": {
          "start": "#00e5ff",
          "end": "#00b8d4",
          "glow": "rgba(0,229,255,0.18)"
        }
      },
      "status": {
        "warn": "#ff8c00",
        "danger": "#ff4d6b",
        "success": "#22c55e"
      },
      "error": {
        "fg": "#ff4d6b",
        "bg": "#1a0008",
        "border": "#ffffff"
      },
      "radius": { "sm": "1px", "md": "2px", "lg": "4px", "xl": "6px", "full": "9999px" },
      "spacing": { "sm": "4px", "md": "8px", "lg": "16px", "xl": "24px" },
      "shadow": {
        "sm": "0 1px 2px color-mix(in oklch, var(--color-surface-app) 60%, transparent)",
        "md": "0 2px 8px color-mix(in oklch, var(--color-surface-app) 55%, transparent)",
        "lg": "0 8px 24px color-mix(in oklch, var(--color-surface-app) 50%, transparent)"
      },
      "editor": {
        "caret": "#ffd400",
        "selection": "rgba(255,212,0,0.35)",
        "selection_text": "#000000",
        "link": "#00e5ff",
        "link_hover": "#00b8d4",
        "highlight": "rgba(255,140,0,0.40)"
      }
    },
    "light": {
      "surfaces": {
        "app": { "bg": "#ffffff", "border": "#6e6e6e", "text": "#000000" },
        "panel": { "bg": "#ffffff", "border": "#4a4a4a", "text": "#000000" },
        "modal": { "bg": "#ffffff", "border": "#000000", "text": "#000000" },
        "card": { "bg": "#ededed", "border": "#4a4a4a", "text": "#000000" }
      },
      "hover": "#dcdcdc",
      "active": "#c4c4c4",
      "border_active": "#000000",
      "border_focus": "#0000cc",
      "text_muted": "#2b2b2b",
      "text_disabled": "#5a5a5a",
      "accent": {
        "primary": {
          "start": "#8a5a00",
          "end": "#6f4800",
          "glow": "rgba(138,90,0,0.16)"
        },
        "secondary": {
          "start": "#005f70",
          "end": "#00475a",
          "glow": "rgba(0,95,112,0.14)"
        }
      },
      "status": {
        "warn": "#9c5800",
        "danger": "#b3000c",
        "success": "#16a34a"
      },
      "error": {
        "fg": "#b3000c",
        "bg": "#ffe6e6",
        "border": "#000000"
      },
      "radius": { "sm": "1px", "md": "2px", "lg": "4px", "xl": "6px", "full": "9999px" },
      "spacing": { "sm": "4px", "md": "8px", "lg": "16px", "xl": "24px" },
      "shadow": {
        "sm": "0 1px 2px color-mix(in oklch, var(--color-surface-app) 45%, transparent)",
        "md": "0 2px 8px color-mix(in oklch, var(--color-surface-app) 40%, transparent)",
        "lg": "0 8px 24px color-mix(in oklch, var(--color-surface-app) 35%, transparent)"
      },
      "editor": {
        "caret": "#8a5a00",
        "selection": "rgba(138,90,0,0.30)",
        "selection_text": "#ffffff",
        "link": "#005f70",
        "link_hover": "#00475a",
        "highlight": "rgba(156,88,0,0.35)"
      }
    }
  }
}
