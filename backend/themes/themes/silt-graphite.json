{
  "schema_version": "2.0.0",
  "id": "silt-graphite",
  "name": "Graphite",
  "author": "Chelydra Labs",
  "description": "A calm monochrome dark: true neutral-gray canvas with a single restrained blue accent.",
  "typography": {
    "font_family": "'Geist', sans-serif",
    "mono_font_family": "'Geist Mono', monospace",
    "headline_font": "'Schibsted Grotesk', sans-serif",
    "scale": {
      "size": { "xs": "0.75rem", "sm": "0.875rem", "base": "1.0625rem", "lg": "1.1875rem", "xl": "1.375rem", "2xl": "1.75rem" },
      "line_height": { "tight": "1.25", "normal": "1.6", "relaxed": "1.8" },
      "weight": { "normal": "400", "medium": "500", "semibold": "600" }
    }
  },
  "modes": {
    "dark": {
      "surfaces": {
        "app": { "bg": "#0a0a0a", "border": "#1b1b1b", "text": "#ebebeb" },
        "editor": { "bg": "#0d0d0d", "border": "#1f1f1f", "text": "#ebebeb" },
        "panel": { "bg": "#101010", "border": "#262626", "text": "#ebebeb" },
        "modal": { "bg": "#131313", "border": "#3a3a3a", "text": "#ebebeb" },
        "card": { "bg": "#161616", "border": "#262626", "text": "#ebebeb" },
        "popover": { "bg": "#1a1a1a", "border": "#404040", "text": "#ebebeb" }
      },
      "hover": "#1d1d1d",
      "active": "#262626",
      "border_active": "#3a3a3a",
      "border_focus": "#5c5c5c",
      "text_muted": "#9a9a9a",
      "text_disabled": "#4d4d4d",
      "accent": {
        "primary": {
          "start": "#6f9ad8",
          "end": "#4d72a0",
          "glow": "rgba(111, 154, 216, 0.12)"
        },
        "secondary": {
          "start": "#9aa3ad",
          "end": "#6f7882",
          "glow": "rgba(154, 163, 173, 0.10)"
        }
      },
      "status": {
        "warn": "#c8b074",
        "danger": "#c25555",
        "success": "#5a9678"
      },
      "error": {
        "fg": "#d97070",
        "bg": "#1a1212",
        "border": "#3a2a2a"
      },
      "radius": { "sm": "2px", "md": "4px", "lg": "6px", "xl": "8px", "full": "9999px" },
      "spacing": { "sm": "4px", "md": "6px", "lg": "12px", "xl": "20px" },
      "shadow": {
        "sm": "0 1px 2px color-mix(in oklch, var(--color-surface-app) 45%, transparent)",
        "md": "0 3px 10px color-mix(in oklch, var(--color-surface-app) 40%, transparent)",
        "lg": "0 10px 28px color-mix(in oklch, var(--color-surface-app) 35%, transparent)"
      },
      "editor": {
        "caret": "#6f9ad8",
        "selection": "rgba(111,154,216,0.22)",
        "selection_text": "#ebebeb",
        "link": "#9aa3ad",
        "link_hover": "#6f7882",
        "highlight": "rgba(200,176,116,0.25)"
      }
    },
    "light": {
      "surfaces": {
        "app": { "bg": "#e4e4e4", "border": "#969696", "text": "#1a1a1a" },
        "editor": { "bg": "#eaeaea", "border": "#9a9a9a", "text": "#1a1a1a" },
        "panel": { "bg": "#efefef", "border": "#9e9e9e", "text": "#1a1a1a" },
        "card": { "bg": "#f4f4f4", "border": "#8c8c8c", "text": "#1a1a1a" },
        "modal": { "bg": "#f8f8f8", "border": "#747474", "text": "#1a1a1a" },
        "popover": { "bg": "#fdfdfd", "border": "#6a6a6a", "text": "#1a1a1a" }
      },
      "hover": "#d6d6d6",
      "active": "#c2c2c2",
      "border_active": "#8a8a8a",
      "border_focus": "#525252",
      "text_muted": "#454545",
      "text_disabled": "#969696",
      "accent": {
        "primary": {
          "start": "#4a6fa0",
          "end": "#374f78",
          "glow": "rgba(74, 111, 160, 0.10)"
        },
        "secondary": {
          "start": "#6a737d",
          "end": "#525a63",
          "glow": "rgba(106, 115, 125, 0.08)"
        }
      },
      "status": {
        "warn": "#7a6428",
        "danger": "#9c4848",
        "success": "#3a7a5a"
      },
      "error": {
        "fg": "#7e3838",
        "bg": "#fbe6e6",
        "border": "#c08080"
      },
      "radius": { "sm": "2px", "md": "4px", "lg": "6px", "xl": "8px", "full": "9999px" },
      "spacing": { "sm": "4px", "md": "6px", "lg": "12px", "xl": "20px" },
      "shadow": {
        "sm": "0 1px 2px color-mix(in oklch, var(--color-surface-app) 28%, transparent)",
        "md": "0 3px 10px color-mix(in oklch, var(--color-surface-app) 22%, transparent)",
        "lg": "0 10px 28px color-mix(in oklch, var(--color-surface-app) 18%, transparent)"
      },
      "editor": {
        "caret": "#4a6fa0",
        "selection": "rgba(74,111,160,0.18)",
        "selection_text": "#1a1a1a",
        "link": "#6a737d",
        "link_hover": "#525a63",
        "highlight": "rgba(122,100,40,0.22)"
      }
    }
  }
}
