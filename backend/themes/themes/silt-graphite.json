{
  "schema_version": "2.0.0",
  "id": "silt-graphite",
  "name": "Graphite",
  "author": "Chelydra Labs",
  "description": "A calm monochrome dark: true neutral-gray canvas with a single restrained blue accent.",
  "typography": {
    "font_family": "'Geist', sans-serif",
    "mono_font_family": "'Geist Mono', monospace",
    "headline_font": "'Schibsted Grotesk', sans-serif"
  },
  "modes": {
    "dark": {
      "surfaces": {
        "app": { "bg": "#0a0a0a", "border": "#1b1b1b", "text": "#ebebeb" },
        "panel": { "bg": "#101010", "border": "#262626", "text": "#ebebeb" },
        "modal": { "bg": "#101010", "border": "#3a3a3a", "text": "#ebebeb" },
        "card": { "bg": "#161616", "border": "#262626", "text": "#ebebeb" }
      },
      "hover": "#1d1d1d",
      "active": "#262626",
      "border_active": "#3a3a3a",
      "border_focus": "#5c5c5c",
      "text_muted": "#9a9a9a",
      "text_disabled": "#4d4d4d",
      "accent": {
        "primary": {
          "start": "#6f9ad8",
          "end": "#4d72a0",
          "glow": "rgba(111, 154, 216, 0.12)"
        },
        "secondary": {
          "start": "#9aa3ad",
          "end": "#6f7882",
          "glow": "rgba(140, 150, 160, 0.10)"
        }
      },
      "status": {
        "warn": "#c9a368",
        "danger": "#b06868",
        "success": "#22c55e"
      },
      "error": {
        "fg": "#b06868",
        "bg": "#101010",
        "border": "#3a3a3a"
      }
    },
    "light": {
      "surfaces": {
        "app": { "bg": "#f8f8f8", "border": "#e6e6e6", "text": "#1a1a1a" },
        "panel": { "bg": "#ffffff", "border": "#d8d8d8", "text": "#1a1a1a" },
        "modal": { "bg": "#ffffff", "border": "#bababa", "text": "#1a1a1a" },
        "card": { "bg": "#f0f0f0", "border": "#d8d8d8", "text": "#1a1a1a" }
      },
      "hover": "#e6e6e6",
      "active": "#d8d8d8",
      "border_active": "#bababa",
      "border_focus": "#6e6e6e",
      "text_muted": "#585858",
      "text_disabled": "#a3a3a3",
      "accent": {
        "primary": {
          "start": "#4a6fa0",
          "end": "#374f78",
          "glow": "rgba(74, 111, 160, 0.10)"
        },
        "secondary": {
          "start": "#6a737d",
          "end": "#525a63",
          "glow": "rgba(90, 100, 110, 0.08)"
        }
      },
      "status": {
        "warn": "#9a6e1a",
        "danger": "#a33235",
        "success": "#16a34a"
      },
      "error": {
        "fg": "#a33235",
        "bg": "#ffffff",
        "border": "#bababa"
      }
    }
  }
}
