        "surface": "#121d35",
        "panel": "#162540",
        "hover": "#1c2d4c",
        "active": "#243658"
      },
      "border": {
        "muted": "#1a2840",
        "zinc": "#243658",
        "active": "#344d70",
        "focus": "#4a6090"
      },
