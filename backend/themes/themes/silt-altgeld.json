{
  "schema_version": "2.0.0",
  "id": "silt-altgeld",
  "name": "Altgeld",
  "author": "Chelydra Labs",
  "description": "Prairie-fire energy: Illinois Blue canvas with Illini Orange primary and electric blue secondary. The blaze of a prairie fire at dusk over the central Illinois tallgrass.",
  "typography": {
    "font_family": "'Public Sans', sans-serif",
    "mono_font_family": "'Martian Mono', monospace",
    "headline_font": "'Schibsted Grotesk', sans-serif"
  },
  "modes": {
    "dark": {
      "surfaces": {
        "app": { "bg": "#0d1525", "border": "#1a2840", "text": "#e6ecf5" },
        "panel": { "bg": "#121d35", "border": "#243658", "text": "#e6ecf5" },
        "modal": { "bg": "#121d35", "border": "#344d70", "text": "#e6ecf5" },
        "card": { "bg": "#162540", "border": "#243658", "text": "#e6ecf5" }
      },
      "hover": "#1c2d4c",
      "active": "#243658",
      "border_active": "#344d70",
      "border_focus": "#4a6090",
      "text_muted": "#94a4bc",
      "text_disabled": "#4a5a70",
      "accent": {
        "primary": {
          "start": "#ff5f05",
          "end": "#cc4a00",
          "glow": "rgba(255,95,5,0.15)"
        },
        "secondary": {
          "start": "#4080e0",
          "end": "#2050a0",
          "glow": "rgba(64,128,224,0.12)"
        }
      },
      "status": {
        "warn": "#fbbf24",
        "danger": "#f43f5e",
        "success": "#22c55e"
      },
      "error": {
        "fg": "#f43f5e",
        "bg": "#121d35",
        "border": "#344d70"
      }
    },
    "light": {
      "surfaces": {
        "app": { "bg": "#eaf0f6", "border": "#dde6f0", "text": "#13294b" },
        "panel": { "bg": "#ffffff", "border": "#c8d6e6", "text": "#13294b" },
        "modal": { "bg": "#ffffff", "border": "#94a8c0", "text": "#13294b" },
        "card": { "bg": "#e4eaf2", "border": "#c8d6e6", "text": "#13294b" }
      },
      "hover": "#dae2ee",
      "active": "#c6d2e2",
      "border_active": "#94a8c0",
      "border_focus": "#5a7090",
      "text_muted": "#3a4a60",
      "text_disabled": "#8a9aae",
      "accent": {
        "primary": {
          "start": "#c44a00",
          "end": "#9a3800",
          "glow": "rgba(255,95,5,0.10)"
        },
        "secondary": {
          "start": "#1a3677",
          "end": "#0d1f4d",
          "glow": "rgba(19,41,75,0.08)"
        }
      },
      "status": {
        "warn": "#9a6e1a",
        "danger": "#b3000c",
        "success": "#16a34a"
      },
      "error": {
        "fg": "#b3000c",
        "bg": "#ffffff",
        "border": "#94a8c0"
      }
    }
  }
}
