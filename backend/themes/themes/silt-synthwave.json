{
  "schema_version": "2.0.0",
  "id": "silt-synthwave",
  "name": "Synthwave",
  "author": "Chelydra Labs",
  "description": "80s retro neon: deep indigo canvas with hot-pink and electric-cyan accents. Think Miami Vice, Tron, and synthwave album covers. A faded pastel light mode evokes a sun-bleach poster.",
  "typography": {
    "font_family": "'Figtree', sans-serif",
    "mono_font_family": "'Space Mono', monospace",
    "headline_font": "'Bricolage Grotesque', sans-serif",
    "scale": {
      "size": { "xs": "0.75rem", "sm": "0.875rem", "base": "1rem", "lg": "1.125rem", "xl": "1.25rem", "2xl": "1.5rem" },
      "line_height": { "tight": "1.15", "normal": "1.5", "relaxed": "1.7" },
      "weight": { "normal": "400", "medium": "500", "semibold": "600" }
    }
  },
  "modes": {
    "dark": {
      "surfaces": {
        "app": { "bg": "#0d0b1a", "border": "#1f1c35", "text": "#e8e6f0" },
        "editor": {
          "bg": "#0d0b1a",
          "border": "#1f1c35",
          "text": "#e8e6f0",
          "background": {
            "image": "repeating-linear-gradient(0deg, rgba(0,240,255,0.6) 0 1px, transparent 1px 40px), repeating-linear-gradient(90deg, rgba(255,45,149,0.6) 0 1px, transparent 1px 40px)",
            "size": "tile",
            "opacity": 0.08,
            "blend": "overlay"
          }
        },
        "panel": { "bg": "#141126", "border": "#2a2745", "text": "#e8e6f0" },
        "modal": { "bg": "#181530", "border": "#3f3a5e", "text": "#e8e6f0" },
        "card": { "bg": "#1a1830", "border": "#2a2745", "text": "#e8e6f0" },
        "popover": { "bg": "#1e1a36", "border": "#4a4570", "text": "#e8e6f0" }
      },
      "hover": "#221f3a",
      "active": "#2a2745",
      "border_active": "#3f3a5e",
      "border_focus": "#5a5280",
      "text_muted": "#9a96b0",
      "text_disabled": "#4a4660",
      "accent": {
        "primary": {
          "start": "oklch(0.665 0.249 357)",
          "end": "oklch(0.606 0.23 10)",
          "glow": "rgba(233,30,99,0.18)"
        },
        "secondary": {
          "start": "oklch(0.87 0.148 203)",
          "end": "oklch(0.719 0.126 214)",
          "glow": "rgba(0,240,255,0.15)"
        }
      },
      "status": {
        "warn": "#ffb04a",
        "danger": "#ff3d6e",
        "success": "#5ce0c4"
      },
      "error": {
        "fg": "#ff5a85",
        "bg": "#1f0a14",
        "border": "#5a1a38"
      },
      "radius": { "sm": "3px", "md": "6px", "lg": "8px", "xl": "12px", "full": "9999px" },
      "spacing": { "sm": "4px", "md": "6px", "lg": "10px", "xl": "16px" },
      "shadow": {
        "sm": "0 1px 2px color-mix(in oklch, var(--color-surface-app) 55%, transparent)",
        "md": "0 4px 16px color-mix(in oklch, var(--color-accent-primary-start) 12%, transparent), 0 2px 8px color-mix(in oklch, var(--color-surface-app) 40%, transparent)",
        "lg": "0 8px 32px color-mix(in oklch, var(--color-accent-primary-start) 15%, transparent), 0 4px 16px color-mix(in oklch, var(--color-accent-secondary-start) 10%, transparent)"
      },
      "editor": {
        "caret": "oklch(0.665 0.249 357)",
        "selection": "rgba(255,45,149,0.30)",
        "selection_text": "#e8e6f0",
        "link": "oklch(0.87 0.148 203)",
        "link_hover": "oklch(0.719 0.126 214)",
        "highlight": "rgba(255,180,80,0.30)"
      }
    },
    "light": {
      "surfaces": {
        "app": { "bg": "#e2deec", "border": "#8478a4", "text": "#1c1c34" },
        "editor": { "bg": "#e8e4f1", "border": "#887ca8", "text": "#1c1c34" },
        "panel": { "bg": "#ede9f4", "border": "#8c80ac", "text": "#1c1c34" },
        "card": { "bg": "#f2eff7", "border": "#746894", "text": "#1c1c34" },
        "modal": { "bg": "#f7f5fb", "border": "#5e547e", "text": "#1c1c34" },
        "popover": { "bg": "#fcfafd", "border": "#524872", "text": "#1c1c34" }
      },
      "hover": "#d4cee4",
      "active": "#c0b8d8",
      "border_active": "#8e78a4",
      "border_focus": "#5c4880",
      "text_muted": "#3c3c5c",
      "text_disabled": "#8e86a4",
      "accent": {
        "primary": {
          "start": "oklch(0.531 0.202 6)",
          "end": "oklch(0.415 0.16 356)",
          "glow": "rgba(194,24,91,0.10)"
        },
        "secondary": {
          "start": "oklch(0.557 0.095 206)",
          "end": "oklch(0.444 0.076 200)",
          "glow": "rgba(0,131,143,0.08)"
        }
      },
      "status": {
        "warn": "#9a6822",
        "danger": "#9c1640",
        "success": "#1f8a6a"
      },
      "error": {
        "fg": "#7a1838",
        "bg": "#fbe6ee",
        "border": "#c878a4"
      },
      "radius": { "sm": "3px", "md": "6px", "lg": "8px", "xl": "12px", "full": "9999px" },
      "spacing": { "sm": "4px", "md": "6px", "lg": "10px", "xl": "16px" },
      "shadow": {
        "sm": "0 1px 2px color-mix(in oklch, var(--color-surface-app) 32%, transparent)",
        "md": "0 4px 12px color-mix(in oklch, var(--color-surface-app) 25%, transparent)",
        "lg": "0 12px 32px color-mix(in oklch, var(--color-surface-app) 20%, transparent)"
      },
      "editor": {
        "caret": "oklch(0.531 0.202 6)",
        "selection": "rgba(194,24,91,0.20)",
        "selection_text": "#1c1c34",
        "link": "oklch(0.557 0.095 206)",
        "link_hover": "oklch(0.444 0.076 200)",
        "highlight": "rgba(154,104,34,0.22)"
      }
    }
  }
}
