{
  "schema_version": "2.0.0",
  "id": "silt-terra-noir",
  "name": "Terra Noir",
  "author": "Chelydra Labs",
  "description": "Dark earth palette: warm near-black canvas with clay primary and moss secondary accents.",
  "typography": {
    "font_family": "'Source Serif 4', serif",
    "mono_font_family": "'IBM Plex Mono', monospace",
    "headline_font": "'Newsreader', serif"
  },
  "modes": {
    "dark": {
      "surfaces": {
        "app": { "bg": "#100b07", "border": "#241b12", "text": "#ece3d5" },
        "panel": { "bg": "#17110b", "border": "#332719", "text": "#ece3d5" },
        "modal": { "bg": "#17110b", "border": "#4d3a24", "text": "#ece3d5" },
        "card": { "bg": "#1d160f", "border": "#332719", "text": "#ece3d5" }
      },
      "hover": "#251c13",
      "active": "#2d2217",
      "border_active": "#4d3a24",
      "border_focus": "#6f5536",
      "text_muted": "#a89478",
      "text_disabled": "#564736",
      "accent": {
        "primary": {
          "start": "#e07a3c",
          "end": "#b4421a",
          "glow": "rgba(224,122,60,0.15)"
        },
        "secondary": {
          "start": "#84a04a",
          "end": "#5e7d2f",
          "glow": "rgba(132,160,74,0.12)"
        }
      },
      "status": {
        "warn": "#f0a823",
        "danger": "#d83a3a",
        "success": "#22c55e"
      },
      "error": {
        "fg": "#d83a3a",
        "bg": "#17110b",
        "border": "#4d3a24"
      }
    },
    "light": {
      "surfaces": {
        "app": { "bg": "#f6efe4", "border": "#e4d8c3", "text": "#2a2014" },
        "panel": { "bg": "#fbf6ec", "border": "#d2c2a4", "text": "#2a2014" },
        "modal": { "bg": "#fbf6ec", "border": "#a98e68", "text": "#2a2014" },
        "card": { "bg": "#efe6d6", "border": "#d2c2a4", "text": "#2a2014" }
      },
      "hover": "#e4d8c3",
      "active": "#d2c2a4",
      "border_active": "#a98e68",
      "border_focus": "#7c6444",
      "text_muted": "#5a4a36",
      "text_disabled": "#a08a6b",
      "accent": {
        "primary": {
          "start": "#c2511f",
          "end": "#9a3a14",
          "glow": "rgba(194,81,31,0.12)"
        },
        "secondary": {
          "start": "#5a7d2a",
          "end": "#44611d",
          "glow": "rgba(90,125,42,0.10)"
        }
      },
      "status": {
        "warn": "#b8791a",
        "danger": "#bd3434",
        "success": "#16a34a"
      },
      "error": {
        "fg": "#bd3434",
        "bg": "#fbf6ec",
        "border": "#a98e68"
      }
    }
  }
}
