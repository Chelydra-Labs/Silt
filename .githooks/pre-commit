#!/usr/bin/env bash
echo "Running pre-commit hooks (Prettier check)..."

# 1. Exempt if a merge commit is in progress
if git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
  echo "Merge commit in progress. Exempting pre-commit hooks."
  exit 0
fi

# NUL-delimited staged paths (exclude deletions: removed files have no content
# for Prettier, and including them made the hook fail on normal removals).
# git diff -z + xargs -0 keep paths with spaces intact; -n 40 batches for
# Windows CreateProcess argv limits ("The command line is too long").
STAGED_TMP=$(mktemp) || exit 1
FE_TMP=$(mktemp) || { rm -f "$STAGED_TMP"; exit 1; }
FE_REL_TMP=$(mktemp) || { rm -f "$STAGED_TMP" "$FE_TMP"; exit 1; }
trap 'rm -f "$STAGED_TMP" "$FE_TMP" "$FE_REL_TMP"' EXIT

git diff --cached -z --name-only --diff-filter=d >"$STAGED_TMP" || exit 1

# Empty staged set (NUL file with no bytes)
if [ ! -s "$STAGED_TMP" ]; then
  exit 0
fi

# If every staged path is docs/assets only, skip (NUL-safe scan).
# Uses bash `read -d ''` for NUL-delimited paths (shebang is bash on
# Windows Git Bash and Linux; macOS is out of scope for this hook).
CODE_FOUND=0
while IFS= read -r -d '' path || [ -n "$path" ]; do
  case "$path" in
    *.md|*.txt|*.png|*.jpg|*.jpeg|*.gif|*.svg) ;;
    *) CODE_FOUND=1; break ;;
  esac
done <"$STAGED_TMP"

if [ "$CODE_FOUND" -eq 0 ]; then
  echo "Only documentation, text, or asset changes detected. Exempting pre-commit hooks."
  exit 0
fi

# Collect frontend/src Prettier targets (repo-relative paths, NUL-delimited).
: >"$FE_TMP"
while IFS= read -r -d '' path || [ -n "$path" ]; do
  case "$path" in
    frontend/src/*)
      case "$path" in
        *.ts|*.svelte|*.css)
          printf '%s\0' "$path" >>"$FE_TMP"
          ;;
      esac
      ;;
  esac
done <"$STAGED_TMP"

if [ ! -s "$FE_TMP" ]; then
  echo "No staged frontend code files to check. Skipping Prettier check."
  exit 0
fi

echo "Checking formatting of staged files:"
while IFS= read -r -d '' path || [ -n "$path" ]; do
  echo "  - $path"
done <"$FE_TMP"

# Auto-format staged frontend files, then re-stage so the fix rides with the
# commit. Prettier, prettier-plugin-svelte, and .prettierrc live in frontend/
# (repo root has no package.json), so this MUST run from there — otherwise npx
# resolves a config-less prettier that can't parse Svelte. Strip the leading
# "frontend/" so paths resolve from within frontend/.
: >"$FE_REL_TMP"
while IFS= read -r -d '' path || [ -n "$path" ]; do
  rel=${path#frontend/}
  printf '%s\0' "$rel" >>"$FE_REL_TMP"
done <"$FE_TMP"

if (cd frontend && xargs -0 -n 40 npx prettier --write <"$FE_REL_TMP"); then
  # Re-stage with repo-relative paths (still NUL-safe + batched).
  xargs -0 -n 40 git add <"$FE_TMP"
else
  echo "ERROR: Prettier failed to format staged frontend files; see output above."
  exit 1
fi

# ESLint on staged FE sources only (not full-repo lint:typed). Catches unused
# vars, a11y, and type-aware rules that Prettier cannot see — the class of
# failure that otherwise only shows up in CI's Frontend job.
ESLINT_REL_TMP=$(mktemp) || exit 1
trap 'rm -f "$STAGED_TMP" "$FE_TMP" "$FE_REL_TMP" "$ESLINT_REL_TMP"' EXIT
: >"$ESLINT_REL_TMP"
while IFS= read -r -d '' path || [ -n "$path" ]; do
  case "$path" in
    frontend/src/*)
      case "$path" in
        *.ts|*.js|*.svelte)
          printf '%s\0' "${path#frontend/}" >>"$ESLINT_REL_TMP"
          ;;
      esac
      ;;
  esac
done <"$STAGED_TMP"

if [ -s "$ESLINT_REL_TMP" ]; then
  echo "Linting staged frontend files (eslint --max-warnings 0)..."
  if ! (cd frontend && xargs -0 -n 40 npx eslint --max-warnings 0 <"$ESLINT_REL_TMP"); then
    echo "ERROR: ESLint failed on staged frontend files; see output above."
    echo "  Fix the reported issues (or run: cd frontend && npm run lint:typed)."
    exit 1
  fi
fi

echo "Pre-commit checks passed!"
exit 0
